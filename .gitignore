# ==============================================================================
# LienGuard Root .gitignore
# ==============================================================================

# Redundant staging / local snapshot directories
app-source/
app-source-complete/
Manus_Delivery/

# Dependencies
node_modules/
**/node_modules/
.pnpm-store/
jspm_packages/

# Build and Distribution Outputs
dist/
**/dist/
build/
**/build/
out/
*.dist
*.bundle.*
.next/
.nuxt/
.out/
.storybook-out/

# Environment Variables and Secrets
.env
.env.*
!.env.example
!.env.test.example
*.local

# Logs and Diagnostics
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Runtime Data and PIDs
pids/
*.pid
*.seed
*.pid.lock
*.bak

# Test and Coverage
coverage/
*.lcov
.nyc_output/
.vitest/

# IDE, Editor, and Tool Caches
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/
*.swp
*.swo
*~
*.sublime-project
*.sublime-workspace
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
[Dd]esktop.ini

# TypeScript / Bundler Caches
*.tsbuildinfo
.cache/
.parcel-cache/
.eslintcache
.stylelintcache
.prettiercache
.rpt2_cache/
.rts2_cache_cjs/
.rts2_cache_es/
.rts2_cache_umd/
.node_repl_history

# Packaging and Archive Outputs
*.tgz
*.tar.gz
*.zip
*.7z
.yarn-integrity

# Databases and Local Storage
*.db
*.db-journal
*.sqlite
*.sqlite3
*.sqlite3-journal

# Webdev / Manus System Artifacts
.webdev/
.manus-logs/
.gemini/
client/public/__manus__/version.json
.project-config.json

# Local Uploads and Data
uploads/
**/uploads/

# Temporary and Scratch Dirs
tmp/
temp/
scratch/
migration-error.txt
*.tmp
