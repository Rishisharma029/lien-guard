# ==============================================================================
# LienGuard Environment Variables Template
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=3000
VITE_APP_ID=lien-guard-prod

# Database Connection (MySQL / TiDB / PlanetScale)
DATABASE_URL=mysql://root:password@localhost:3306/lienguard

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_characters_long
OAUTH_SERVER_URL=https://auth.example.com
OWNER_OPEN_ID=admin_open_id_token

# Storage Configuration (AWS S3 or Compatible Object Store)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=lienguard-documents

# Optional LLM / AI Integration
BUILT_IN_FORGE_API_URL=https://api.example.com
BUILT_IN_FORGE_API_KEY=your_api_key_here
