# ==============================================================================
# LienGuard Environment Variables Template
# ==============================================================================

# Application Configuration
NODE_ENV=development
PORT=3000
VITE_APP_ID=lien-guard-prod

# Database Connection (MySQL / TiDB / PlanetScale)
DATABASE_URL=mysql://root:password@localhost:3306/lienguard

# Security & Authentication
JWT_SECRET=your_super_secret_jwt_signing_key_at_least_32_characters_long
OAUTH_SERVER_URL=https://auth.example.com
OWNER_OPEN_ID=admin_open_id_token

# Storage Configuration (AWS S3 or Compatible Object Store)
AWS_ACCESS_KEY_ID=your_aws_access_key
AWS_SECRET_ACCESS_KEY=your_aws_secret_key
AWS_REGION=us-east-1
AWS_S3_BUCKET=lienguard-documents

# Optional LLM / AI Integration
BUILT_IN_FORGE_API_URL=https://api.example.com
BUILT_IN_FORGE_API_KEY=your_api_key_here

# Maileroo SMTP (server-only; never prefix these names with VITE_)
# Use a verified sender address belonging to the Maileroo SMTP account's domain.
MAILEROO_SMTP_HOST=smtp.maileroo.com
MAILEROO_SMTP_PORT=587
MAILEROO_SMTP_USER=your_smtp_account@a.maileroo.net
MAILEROO_SMTP_PASSWORD=replace_with_a_deployment_secret
MAILEROO_FROM_EMAIL=notices@your-verified-domain.example
# Reply routing must be configured through Maileroo Inbound Routing before enabling.
MAILEROO_REPLY_TO=case-replies@your-inbound-domain.example
MAILEROO_INBOUND_DOMAIN=your-inbound-domain.example

# Deadline scheduler protection. Generate a long random value only in the deployment secret store.
AUTOMATION_SECRET=replace_with_a_32_plus_character_random_secret
# Automated escalation begins after this many hours past the response deadline.
DEADLINE_ESCALATION_GRACE_HOURS=48
